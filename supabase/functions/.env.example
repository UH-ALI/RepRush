# Template for `supabase/functions/.env` — copy it and fill in local values.
#
#   cp supabase/functions/.env.example supabase/functions/.env
#
# `.env` is gitignored; this file is not, so anything added here must be safe to
# commit. Do not put a real service-role key or a production allowlist in either.
#
# Read by `supabase functions serve` (see `--env-file`). The CLI injects
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY and
# SUPABASE_DB_URL into the edge runtime itself, so they are not listed here.

# Comma-separated route names that run their real handler rather than returning
# canned JSON. Unlisted routes fall through to `_shared/stubs/`. `movements` has
# no stub and is never gated.
LIVE_ENDPOINTS=

# Demo context (J7) — "lat,lng", substituted server-side for allowlisted
# accounts only. Unset means a demo account calling session/start gets a 500
# rather than a silently wrong hex, which is deliberate (`_shared/demo.ts`).
DEMO_LOCATION=
DEMO_SPOT_ID=

# Comma-separated account UUIDs permitted demo context. Server-side allowlist;
# nothing in a request body can add to it.
DEMO_ACCOUNT_IDS=
